{
  "name": "@generative-a11y/docs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm build && node --test tests/rendered-html.test.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test && pnpm test:browser"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.80",
    "@assistant-ui/core": "0.3.15",
    "@assistant-ui/react": "0.15.16",
    "@generative-a11y/ai-sdk": "workspace:*",
    "@generative-a11y/assistant-ui": "workspace:*",
    "@generative-a11y/core": "workspace:*",
    "@generative-a11y/dom": "workspace:*",
    "@generative-a11y/react": "workspace:*",
    "ai": "7.0.77",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-icons": "16.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.53.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.9.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
