{
  "name": "@generative-a11y/ai-sdk",
  "version": "0.0.0",
  "description": "AI SDK lifecycle translation for the generative accessibility runtime",
  "keywords": [
    "accessibility",
    "ai-sdk",
    "generative-ai",
    "react",
    "screen-reader",
    "streaming",
    "vercel-ai-sdk"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/bhaveshchow20/generative-a11y#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhaveshchow20/generative-a11y.git",
    "directory": "packages/ai-sdk"
  },
  "bugs": {
    "url": "https://github.com/bhaveshchow20/generative-a11y/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@generative-a11y/core": "workspace:*"
  },
  "peerDependencies": {
    "@ai-sdk/react": ">=4.0.0 <4.1.0",
    "ai": ">=7.0.0 <7.1.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
