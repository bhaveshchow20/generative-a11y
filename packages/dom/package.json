{
  "name": "@generative-a11y/dom",
  "version": "0.1.0",
  "description": "DOM accessibility delivery for paced screen-reader announcements in streaming AI and agent interfaces.",
  "keywords": [
    "accessibility",
    "aria-live",
    "aria-notify",
    "assistive-technology",
    "generative-ai",
    "live-region",
    "screen-reader",
    "typescript",
    "web-accessibility"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://generativea11y.com/api/dom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhaveshchow20/generative-a11y.git",
    "directory": "packages/dom"
  },
  "bugs": {
    "url": "https://github.com/bhaveshchow20/generative-a11y/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@generative-a11y/core": "workspace:*"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "jsdom": "30.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
